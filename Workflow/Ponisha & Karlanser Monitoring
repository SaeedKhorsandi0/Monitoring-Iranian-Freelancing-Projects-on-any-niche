    {
      "parameters": {
        "jsCode": "// گرفتن اولین آیتم ورودی\nconst item = $input.first().json;\n\n// اگر چیزی نبود، خالی برگردون (بدون خطا)\nif (!item) return [];\n\n// پیدا کردن آرایه‌ها (با تحمل تغییرات کوچک در نام کلید)\nlet titles = [];\nlet links = [];\nlet budgets = [];\nlet descriptions = [];\nlet durations = [];\nlet publisheds = [];\n\nfor (const key in item) {\n  const lowerKey = key.toLowerCase().trim();\n  \n  if (lowerKey.includes(\"title\"))     titles      = item[key] || [];\n  if (lowerKey.includes(\"link\"))      links       = item[key] || [];\n  if (lowerKey.includes(\"budget\"))    budgets     = item[key] || [];\n  if (lowerKey.includes(\"description\")) descriptions = item[key] || [];\n  if (lowerKey.includes(\"duration\"))  durations   = item[key] || [];\n  if (lowerKey.includes(\"published\")) publisheds  = item[key] || [];\n}\n\n// اگر عنوان پیدا نشد → پیام مناسب\nif (!Array.isArray(titles) || titles.length === 0) {\n  return [{ json: { message: \"هیچ پروژه‌ای پیدا نشد\" } }];\n}\n\nconst result = [];\n\nfor (let i = 0; i < titles.length; i++) {\n  const title = (titles[i] || \"\").toString().trim();\n\n  result.push({\n    json: {\n      title: title,\n      link: links[i] ? \"https://karlancer.com\" + (links[i] || \"\") : \"لینک نامشخص\",\n      budget: (budgets[i] || \"نامشخص\").toString().trim(),\n      description: (descriptions[i] || \"بدون توضیحات\").toString().trim(),\n      duration: (durations[i] || \"نامشخص\").toString().trim(),\n      published: (publisheds[i] || \"نامشخص\").toString().trim(),\n      source: \"کارلنسر\"\n    }\n  });\n}\n\nreturn result.length > 0 \n  ? result \n  : [{ json: { message: \"هیچ پروژه‌ای در این لحظه موجود نیست\" } }];"
      },
