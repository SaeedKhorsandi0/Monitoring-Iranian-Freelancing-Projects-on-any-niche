      "parameters": {
        "jsCode": "// تابع کمکی برای تبدیل اعداد فارسی به انگلیسی\nfunction toEnglishDigits(str) {\n  if (!str) return \"\";\n  const persianNumbers = [/۰/g, /۱/g, /۲/g, /۳/g, /۴/g, /۵/g, /۶/g, /۷/g, /۸/g, /۹/g];\n  const arabicNumbers  = [/٠/g, /١/g, /٢/g, /٣/g, /٤/g, /٥/g, /٦/g, /٧/g, /٨/g, /٩/g];\n  \n  let result = str;\n  for (let i = 0; i < 10; i++) {\n    result = result.replace(persianNumbers[i], i).replace(arabicNumbers[i], i);\n  }\n  return result;\n}\n\nconst items = $input.all();\nconst filteredItems = [];\n\nfor (const item of items) {\n  // اگر پیام خطای نود قبلی بود، کلا نادیده بگیر (چون می‌خواهیم دوباره چک کنیم)\n  if (item.json.message && !item.json.title) {\n     continue;\n  }\n\n  const rawPublished = item.json.published || \"\";\n  \n  // ۱. تبدیل اعداد به انگلیسی برای پردازش\n  const publishedText = toEnglishDigits(rawPublished);\n  \n  // ۲. بررسی موارد خاص (بدون عدد) مثل لحظاتی پیش\n  if (publishedText.includes(\"لحظاتی\") || publishedText.includes(\"ثانیه\")) {\n    filteredItems.push(item);\n    continue;\n  }\n  \n  // ۳. استخراج عدد و واحد زمانی\n  const match = publishedText.match(/(\\d+)\\s*(ساعت|روز|دقیقه)/);\n  \n  if (!match) {\n    continue;\n  }\n  \n  const timeValue = parseInt(match[1]); // الان که انگلیسی شده، درست کار میکنه\n  const timeUnit = match[2];\n  \n  // ۴. شرط فیلتر\n  if (timeUnit === \"دقیقه\") {\n    filteredItems.push(item);\n  } else if (timeUnit === \"ساعت\" && timeValue <= 1) {\n    filteredItems.push(item);\n  }\n}\n\n// ۵. اگر خالی بود، آرایه خالی برگردان تا نود تلگرام اصلا اجرا نشود\n// (این بهتر از فرستادن پیام \"هیچ پروژه جدیدی نیست\" به تلگرام است)\nif (filteredItems.length === 0) {\n  return []; \n}\n\nreturn filteredItems;"
      },
