      "parameters": {
        "jsCode": "// نود Code – مستقیم بعد از HTTP Request پونیشا (بدون هیچ فیلتر)\nconst html = $input.first().json.data || $input.first().json.body;\n\nif (!html || typeof html !== 'string') {\n  return [{ json: { error: 'HTML دریافت نشد' } }];\n}\n\n// استخراج __NEXT_DATA__\nconst match = html.match(/<script id=\"__NEXT_DATA__\" type=\"application\\/json\">([\\s\\S]*?)<\\/script>/);\nif (!match) {\n  return [{ json: { error: '__NEXT_DATA__ پیدا نشد' } }];\n}\n\nlet nextData;\ntry {\n  nextData = JSON.parse(match[1]);\n} catch (e) {\n  return [{ json: { error: 'پارس JSON شکست', details: e.message } }];\n}\n\n// مسیر دقیق از فایل تو (تست شده روی فایل Untitled.json)\nconst queries = nextData.props?.pageProps?.initialState?.queries || nextData.props?.pageProps?.dehydratedState?.queries;\n\nif (!queries || !Array.isArray(queries) || queries.length === 0) {\n  return [{ json: { error: 'queries پیدا نشد' } }];\n}\n\n// پیدا کردن query که کلیدش شامل \"search\",\"projects\" باشه\nconst searchQuery = queries.find(q => \n  q.queryKey && q.queryKey.some(k => typeof k === 'string' && k.includes('search')) ||\n  q.queryKey?.[0] === 'search'\n);\n\nif (!searchQuery || !searchQuery.state?.data?.data) {\n  return [{ json: { error: 'داده پروژه پیدا نشد' } }];\n}\n\nconst projects = searchQuery.state.data.data;\n\nif (!Array.isArray(projects) || projects.length === 0) {\n  return [{ json: { message: 'هیچ پروژه‌ای پیدا نشد' } }];\n}\n\n// فقط استخراج – بدون هیچ فیلتر\nreturn projects.map(p => ({\n  json: {\n    title:       p.title || 'بدون عنوان',\n    link:        `https://ponisha.ir/project/${p.id}/${p.slug}`,\n    budget:      p.amount_max === 0 \n                 ? `${(p.amount_min / 1000000).toFixed(0)} میلیون تومان به بالا`\n                 : `${(p.amount_min / 1000000).toFixed(0)} - ${(p.amount_max / 1000000).toFixed(0)} میلیون تومان`,\n    description: p.description ? p.description.substring(0, 300) + '...' : 'بدون توضیحات',\n    published:   p.approved_at ? new Date(p.approved_at).toISOString() : 'نامشخص',\n    source:      'پونیشا',\n    id:          p.id,\n    slug:        p.slug,\n    raw:         p  // برای دیباگ نگه داشتم\n  }\n}));"
      },
